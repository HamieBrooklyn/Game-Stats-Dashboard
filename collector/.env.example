# Copy to collector/.env on the Mac (chmod 600). Never commit .env.

# Open Cloud key: read-only. Permissions for each game's universe:
#   universe-datastores.objects:read (DataStores: read entry, list entry keys)
#   memory-store.sorted-map:read (MemoryStore: read sorted map)
ROBLOX_OPEN_CLOUD_API_KEY=

# The owner's secret: signs you in without Roblox, once per tab (24+ random characters, e.g. `openssl rand -base64 33`)
DASHBOARD_SECRET=

# Where the dashboard is served from (comma-separated, exact: scheme + host, no path): its public address (the
# tunnel) and this Mac
ALLOWED_ORIGINS=https://stats.pokepon.org,http://127.0.0.1:8090,http://localhost:8090

# Sign in with Roblox (README: "Sign in with Roblox"). Without these, only the secret works.
PUBLIC_URL=https://stats.pokepon.org
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# ROBLOX_OAUTH_SCOPES=openid profile universe.user-restriction:read   (the default)

# Optional
PORT=8090
# A dead-man ping (e.g. https://hc-ping.com/<uuid>): alerts you when the Mac or collection stops
HEALTHCHECK_URL=
